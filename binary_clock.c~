#define F_CPU 16000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

volatile uint8_t seconds = 0;
volatile uint8_t minutes = 0;
volatile uint8_t hours = 0;
uint8_t displayMode = 0;
void
timer1_setup ()
{
  OCR1A = 15624;		/*EQUIVALENT to one second */
  TCCR1A = 0;
/*to avoid unintended bit bitchanges*/
  TCCR1B = 0;
  TCNT1 = 0;
  TCCR1B = (1 << WGM12);	/*ENABLE ctc mode , it ensential compare the value to the OCR1A IF ITS same resets and fires an interrupt */
  TCCR1B |= (1 << CS12) | (1 << CS10);	/*THE prescaler to 1024 ,have roughly  or exactly 15624 counts */

  TIMSK1 |= (1 << OCIE1A);	/*TIMER INTERRUOT INTERRUPT TRIggered every time the counter TCNTA and OCR1A matches their value */
}

ISR (TIMER1_COMPA_vect)
{
  seconds++;
  if (seconds >= 60)
    {
      seconds = 0;
      minutes++;
      if (minutes >= 60)
	{
	  minutes = 0;
	  hours++;
	  if (hours >= 24)
	    {
	      hours = 0;
	    }
	}
    }
}

void
displayValue (uint8_t value)
{
/*keep PD0 AND PD1 untouched  (only touch PD2-PD7*/
  PORTD = (PORTD & 0x03) | ((value & 0x3F) << 2);
}

/* debounce the button */
void
checkbutton (void)
{
  static uint8_t last_state = 1;
  uint8_t current_state = (PINB & (1 << PB1)) ? 1 : 0;	//VALUE if true or not used pin b link it up  for else statement
  if (current_state == 0 && last_state == 1)
    {
      _delay_ms (20);
      if (!(PINB & (1 << PB1)))
	{
	  displayMode++;
	  if (displayMode > 2)
	    {
	      displayMode = 0;
	    }
	}
    }
  last_state = current_state;
}

int
main (void)
{
  DDRD |= 0xFc;
  DDRB |= (1 << PB0);
  DDRB &= ~(1 << PB1);
  PORTB |= (1 << PB1);
  timer1_setup ();
  sei ();
  while (1)
    {
      checkbutton ();
      uint8_t valuetoshow =0;
      switch (displayMode)
	{
	case 0:		//hours
	  valuetoshow = hours;
	  PORTB &= ~(1 << PB0);	//led off representaion of seconds
	  break;
	case 1:		//minutes
	  valuetoshow = minutes;
	  PORTB |= (1 << PB0);	//led on to signify thats a minutes
	  break;
	case 2:		// seconds
	  valuetoshow = seconds;
	  if (seconds & 1)
	    {
	      PORTB |= (1 << PB0);
	    }
	  else
	    {
	      PORTB &= ~(1 << PB0);
	    }
	  break;
	default:
	  displayMode = 0;
	}
      displayValue (valuetoshow);
    }
}
